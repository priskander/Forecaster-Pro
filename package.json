{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:security": "tsx scripts/test-security-remediation.ts",
    "test:backup": "tsx scripts/test-backup-restoration.ts",
    "test": "tsx scripts/test-security-remediation.ts && tsx scripts/test-backup-restoration.ts",
    "package:source": "tar --exclude=node_modules --exclude=data --exclude=backups --exclude=dist --exclude=build --exclude=coverage --exclude=.git --exclude='.env' --exclude='.env.local' --exclude='.env.production' --exclude='.env.development' --exclude='.env.test' --exclude='*.db' --exclude='*.sqlite' --exclude='*.sqlite3' --exclude='*.bak' --exclude='*.backup' --exclude='*.dump' --exclude='*.tmp' --exclude='*.zip' --exclude='*.tar.gz' -czf forecaster-pro-source.tar.gz ."
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0"
  }
