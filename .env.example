# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ALLOWED_ORIGINS: Comma-separated explicit origins allowed by CORS in production.
# Example: ALLOWED_ORIGINS="https://app.forecasterpro.com,https://admin.forecasterpro.com"
ALLOWED_ORIGINS="https://app.example.com"

# DB_FILE: Optional custom path for JSON persistence (used for isolated test runs).
# Defaults to ./data/cloud-ledger-db.json when omitted.
# DB_FILE="./data/cloud-ledger-db.json"

# INITIAL_ADMIN_EMAIL: Initial administrator provisioning email.
INITIAL_ADMIN_EMAIL="admin@forecasterpro.com"

# INITIAL_ADMIN_PASSWORD: Required secret for initial administrator account provisioning.
# Must be at least 10 characters and contain upper, lower, digit, and special characters.
# Never commit real credentials to source control.
INITIAL_ADMIN_PASSWORD="REPLACE_WITH_STRONG_UNGUESSABLE_SECRET"

# ENABLE_DEMO_MODE: Interactive demo provisioning and login are disabled by default.
# Set to "true" only in dedicated demo/sandbox environments.
ENABLE_DEMO_MODE="false"

# DEMO_USER_EMAIL: Optional custom email for the isolated demo-showcase-vault account.
# DEMO_USER_EMAIL="demo@forecasterpro.com"

# DEMO_USER_PASSWORD: Optional high-entropy password if password login to the demo user is needed
# when ENABLE_DEMO_MODE="true". When omitted, a random unguessable secret is generated automatically.
# DEMO_USER_PASSWORD="REPLACE_WITH_STRONG_UNGUESSABLE_SECRET"

# OUTBOUND EMAIL TRANSPORT (Required to deliver Password Reset & Sub-User Invitation emails)
# Option 1: Standard SMTP (e.g. Gmail App Password, Outlook, SendGrid SMTP, Amazon SES SMTP)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_SECURE="true"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="REPLACE_WITH_APP_PASSWORD_OR_SMTP_SECRET"
# SMTP_FROM="Forecaster Pro <your-email@gmail.com>"
#
# Option 2: Resend HTTPS Email API (Alternative to SMTP)
# RESEND_API_KEY="REPLACE_WITH_RESEND_API_KEY"
